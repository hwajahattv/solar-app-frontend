# Gateway API base used at build time by scripts/write-env.mjs.
# Prefer same-origin `/api/v1` (Vercel rewrites proxy to the Nest app).
# Only use an absolute URL if you need cross-origin calls and CORS is configured.
API_BASE_URL=/api/v1

# Vercel Edge PIN gate (set in the Vercel project env; never commit real values)
APP_PIN=123456
PIN_SECRET=replace-with-a-long-random-string
